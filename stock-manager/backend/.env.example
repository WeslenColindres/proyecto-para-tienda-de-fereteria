# Server
PORT=4000
NODE_ENV=development
WEBHOOK_URL=

# Security (solo backend <-> desktop)
DESKTOP_API_KEY=change-this-key
LOCAL_ONLY=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_manager
DB_USER=stock_user
DB_PASSWORD=stock_pass
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20

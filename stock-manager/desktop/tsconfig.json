{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2020"], // aquí ya no necesitas DOM
    "types": ["node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload.ts"
  ],
  "exclude": [
    "src/renderer/**"
  ]
}